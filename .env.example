# Gemini API key used by the backend. Never exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model
GEMINI_MODEL=gemini-flash-latest
# Optional: Google PageSpeed Insights API key for reliable Lighthouse / Core Web
# Vitals in the audit. Without it, PSI runs unkeyed (rate-limited) and the audit
# falls back to our own measured signals.
PSI_API_KEY=

# Backend port
PORT=8787
